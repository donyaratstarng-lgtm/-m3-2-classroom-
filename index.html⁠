                    </label>
                </div>
            </div>
            <div class="flex space-x-2 pt-2">
                <button onclick="closeLostModal()" class="flex-1 py-2.5 bg-slate-100 text-slate-600 rounded-xl font-semibold text-sm hover:bg-slate-200 transition">ยกเลิก</button>
                <button onclick="saveLostItem()" class="flex-1 py-2.5 bg-indigo-600 text-white rounded-xl font-semibold text-sm hover:bg-indigo-700 transition">โพสต์แจ้ง</button>
            </div>
        </div>
    </div>

    <!-- Announcement Modal -->
    <div id="announcementModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hide">
        <div class="bg-white rounded-3xl shadow-xl w-full max-w-md p-6 space-y-4">
            <h3 class="text-lg font-bold text-slate-900">สร้างประกาศห้องเรียน</h3>
            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">หัวข้อประกาศ</label>
                    <input type="text" id="annTitle" placeholder="หัวข้อประกาศ..." class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">เนื้อหาประกาศ</label>
                    <textarea id="annContent" rows="3" placeholder="รายละเอียดประกาศ..." class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"></textarea>
                </div>
            </div>
            <div class="flex space-x-2 pt-2">
                <button onclick="closeAnnouncementModal()" class="flex-1 py-2.5 bg-slate-100 text-slate-600 rounded-xl font-semibold text-sm hover:bg-slate-200 transition">ยกเลิก</button>
                <button onclick="saveAnnouncement()" class="flex-1 py-2.5 bg-indigo-600 text-white rounded-xl font-semibold text-sm hover:bg-indigo-700 transition">โพสต์ประกาศ</button>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // 38 Students List
        const studentsList = [
            "ด.ช.กฤษฎา พิศพันธ์",
            "ด.ช.กิตติคุณ สระธรรม",
            "ด.ช.กิตติ์นภัส แซ่เฮ้ง",
            "ด.ช.กิตติพันธ์ ศิริรัตน์",
            "ด.ช.ชัชชัย จันทร์อ่ำ",
            "ด.ช.ชุติภัทร เข็มเพ็ชร",
            "ด.ช.แทนไท หิรัญสถิต",
            "ด.ช.นนทกร จันทร์อ่อน",
            "ด.ช.นนทวรรธน์ จิตร์บุญ",
            "ด.ช.บวร พรศิริ",
            "ด.ช.ปลื้มขวัญ เปลาเร",
            "ด.ช.พงศ์พิทักษ์ แสนเทศ",
            "ด.ช.ภูมิหิรัญ หมื่นจร",
            "ด.ช.ศุภวัฒน์ สงเคราะห์",
            "ด.ช.สุทธิศักดิ์ นิลบดี",
            "ด.ช.อริยะ เลี้ยงสอน",
            "ด.ญ.กันยรัตน์ พิมพา",
            "ด.ญ.กานต์นิชา บรรเทาทุกข์",
            "ด.ญ.ขวัญข้าว สุขชี",
            "ด.ญ.ณัชญา ถวิลรัก",
            "ด.ญ.ณัฐนันท์ เกตุรณชัย",
            "ด.ญ.ณิชกมล สุขศรี",
            "ด.ญ.ดนยรัชฏ์ ภูมิตินทรีย์",
            "ด.ญ.ธัญวรัตน์ โคกแก้ว",
            "ด.ญ.นภสร กาญจนนุกูลศิริ",
            "ด.ญ.นภัสสร เชาว์ไทย",
            "ด.ญ.นัฐทิชา นุชยิ้มย่อง",
            "ด.ญ.นันทิยา พวงมี",
            "ด.ญ.บุศรี บุญธรรม",
            "ด.ญ.เบญจพร สาวทรัพย์",
            "ด.ญ.ปภาวรินทร์ ละอองบัว",
            "ด.ญ.พิมพ์พิศา ธีรพิพัฒน์ธาดา",
            "ด.ญ.วิภามาศ เสลานนท์",
            "ด.ญ.วิลาสินี ชุ้นเกษา",
            "ด.ญ.ศรัญพร พิมพ์เพชร",
            "ด.ญ.สุชาดา เปลาเล",
            "ด.ญ.อลิชา เสลาคุณ",
            "ด.ญ.อัญชิสา วงษ์สนิท"
        ];

        // State variables
        let currentUser = null; // { name, role: 'student'|'admin', nickname, avatar }
        let db = {
            profiles: {}, // name -> { nickname, avatar }
            fees: {},     // week_X -> { studentName: true/false }
            withdrawals: [], // { id, title, amount, date, by }
            homework: [],    // { id, subject, desc, dueDate }
            lostItems: [],   // { id, type, name, desc, image, by, date }
            announcements: [], // { id, title, content, date, by }
            adminPass: '1234'
        };

        // Initialize App on Load
        window.onload = function() {
            loadData();
            populateLoginSelect();
            populateWeekSelect();
            checkSession();
        };

        function loadData() {
            const saved = localStorage.getItem('m3_2_classroom_db');
            if (saved) {
                try { db = JSON.parse(saved); } catch(e) {}
            }
        }

        function saveData() {
            localStorage.setItem('m3_2_classroom_db', JSON.stringify(db));
        }

        function populateLoginSelect() {
            const select = document.getElementById('loginStudentSelect');
            select.innerHTML = '<option value="">-- เลือกรายชื่อนักเรียน (38 คน) --</option>';
            studentsList.forEach((name, idx) => {
                const opt = document.createElement('option');
                opt.value = name;
                opt.textContent = `${idx + 1}. ${name}`;
                select.appendChild(opt);
            });
        }

        function populateWeekSelect() {
            const select = document.getElementById('feeWeekSelect');
            select.innerHTML = '';
            for (let i = 1; i <= 16; i++) {
                const opt = document.createElement('option');
                opt.value = i;
                opt.textContent = `สัปดาห์ที่ ${i} (เก็บ 10 บาท)`;
                select.appendChild(opt);
            }
        }

        function checkSession() {
            const session = localStorage.getItem('m3_2_session');
            if (session) {
                try {
                    currentUser = JSON.parse(session);
                    document.getElementById('loginScreen').classList.add('hide');
                    document.getElementById('mainApp').classList.remove('hide');
                    updateUserUI();
                    renderAllTabs();
                } catch(e) {}
            }
        }

        function handleLogin() {
            const name = document.getElementById('loginStudentSelect').value;
            if (!name) {
                alert('กรุณาเลือกรายชื่อนักเรียนก่อนเข้าสู่ระบบ');
                return;
            }
            currentUser = {
                name: name,
                role: 'student'
            };
            // load profile if exists
            if (db.profiles[name]) {
                currentUser.nickname = db.profiles[name].nickname || '';
                currentUser.avatar = db.profiles[name].avatar || '';
            } else {
                currentUser.nickname = name.split(' ')[1] || name;
                currentUser.avatar = '';
            }

            localStorage.setItem('m3_2_session', JSON.stringify(currentUser));
            document.getElementById('loginScreen').classList.add('hide');
            document.getElementById('mainApp').classList.remove('hide');
            updateUserUI();
            renderAllTabs();
        }

        function logout() {
            localStorage.removeItem('m3_2_session');
            currentUser = null;
            document.getElementById('mainApp').classList.add('hide');
            document.getElementById('loginScreen').classList.remove('hide');
        }

        // Admin Toggle
        function toggleAdminMode() {
            if (currentUser.role === 'admin') {
                currentUser.role = 'student';
                localStorage.setItem('m3_2_session', JSON.stringify(currentUser));
                updateUserUI();
                renderAllTabs();
                alert('ออกจากโหมดแอดมินแล้ว');
            } else {
                openAdminLoginModal();
            }
        }

        function openAdminLoginModal() {
            document.getElementById('adminLoginModal').classList.remove('hide');
            document.getElementById('adminPasswordInput').value = '';
        }
        function closeAdminLoginModal() {
            document.getElementById('adminLoginModal').classList.add('hide');
        }
        function verifyAdminLogin() {
            const pass = document.getElementById('adminPasswordInput').value;
            if (pass === db.adminPass) {
                currentUser.role = 'admin';
                localStorage.setItem('m3_2_session', JSON.stringify(currentUser));
                closeAdminLoginModal();
                updateUserUI();
                renderAllTabs();
                alert('เข้าสู่โหมดแอดมินสำเร็จ!');
            } else {
                alert('รหัสผ่านแอดมินไม่ถูกต้อง!');
            }
        }

        function updateUserUI() {
            const isAdmin = currentUser.role === 'admin';
            document.getElementById('headerRoleBadge').textContent = isAdmin ? 'ผู้ดูแลระบบ (Admin)' : 'นักเรียน (ม.3/2)';
            document.getElementById('headerRoleBadge').className = isAdmin ? 'text-xs px-2.5 py-0.5 bg-amber-100 text-amber-700 rounded-full font-semibold' : 'text-xs px-2.5 py-0.5 bg-indigo-50 text-indigo-600 rounded-full font-medium';
            
            document.getElementById('navUserName').textContent = currentUser.nickname || currentUser.name;
            const avatarImg = document.getElementById('navUserAvatar');
            if (currentUser.avatar) {
                avatarImg.src = currentUser.avatar;
            } else {
                avatarImg.src = 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + encodeURIComponent(currentUser.name);
            }

            // Toggle admin elements
            const adminEls = document.querySelectorAll('.admin-only');
            adminEls.forEach(el => {
                if (isAdmin) el.classList.remove('hide');
                else el.classList.add('hide');
            });

            document.getElementById('adminBtnText').textContent = isAdmin ? 'ออกแอดมิน' : 'โหมดแอดมิน';
        }

        // Profile Modal
        let tempAvatarBase64 = '';
        function openProfileModal() {
            document.getElementById('profileModal').classList.remove('hide');
            document.getElementById('modalRealName').value = currentUser.name;
            document.getElementById('modalNicknameInput').value = currentUser.nickname || '';
            tempAvatarBase64 = currentUser.avatar || '';
            const preview = document.getElementById('modalProfilePreview');
            if (tempAvatarBase64) preview.src = tempAvatarBase64;
            else preview.src = 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + encodeURIComponent(currentUser.name);
        }
        function closeProfileModal() {
            document.getElementById('profileModal').classList.add('hide');
        }
        function previewProfileImage(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    tempAvatarBase64 = e.target.result;
                    document.getElementById('modalProfilePreview').src = tempAvatarBase64;
                }
                reader.readAsDataURL(file);
            }
        }
        function saveProfile() {
            const nickname = document.getElementById('modalNicknameInput').value.trim();
            if (nickname) currentUser.nickname = nickname;
            currentUser.avatar = tempAvatarBase64;

            // save to db profiles
            db.profiles[currentUser.name] = {
                nickname: currentUser.nickname,
                avatar: currentUser.avatar
            };
            saveData();
            localStorage.setItem('m3_2_session', JSON.stringify(currentUser));
            closeProfileModal();
            updateUserUI();
            renderFeeTable();
            alert('บันทึกข้อมูลส่วนตัวเรียบร้อย');
        }

        // Tabs switching
        function switchTab(tabId) {
            document.querySelectorAll('.tab-btn').forEach(btn => {
                if (btn.dataset.tab === tabId) {
                    btn.className = 'tab-btn px-4 py-2 rounded-xl text-sm font-semibold text-indigo-600 bg-indigo-50 transition flex items-center space-x-2 shrink-0';
                } else {
                    btn.className = 'tab-btn px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 transition flex items-center space-x-2 shrink-0';
                }
            });
            ['fund', 'homework', 'lostfound', 'announcement'].forEach(id => {
                document.getElementById(`tab-${id}`).classList.add('hide');
            });
            document.getElementById(`tab-${tabId}`).classList.remove('hide');
        }

        function renderAllTabs() {
            renderFeeTable();
            renderWithdrawals();
            renderHomework();
            renderLostItems();
            renderAnnouncements();
        }

        // --- TAB 1: FEES & FUND ---
        function renderFeeTable() {
            const week = document.getElementById('feeWeekSelect').value || 1;
            const weekKey = `week_${week}`;
            if (!db.fees[weekKey]) db.fees[weekKey] = {};

            const tbody = document.getElementById('feeTableBody');
            tbody.innerHTML = '';

            let paidCount = 0;

            studentsList.forEach((name, idx) => {
                const isPaid = !!db.fees[weekKey][name];
                if (isPaid) paidCount++;

                const profile = db.profiles[name] || {};
                const nickname = profile.nickname || '-';
                const avatar = profile.avatar || ('https://api.dicebear.com/7.x/avataaars/svg?seed=' + encodeURIComponent(name));

                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50/80 transition';
                tr.innerHTML = `
                    <td class="p-3.5 text-center font-medium text-slate-500">${idx + 1}</td>
                    <td class="p-3.5 flex items-center space-x-3">
                        <img src="${avatar}" class="w-8 h-8 rounded-full object-cover border border-slate-200 bg-slate-100">
                        <span class="font-medium text-slate-800">${name}</span>
                    </td>
                    <td class="p-3.5 text-slate-600">${nickname}</td>
                    <td class="p-3.5 text-center">
                        <span class="px-3 py-1 rounded-full text-xs font-semibold ${isPaid ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700'}">
                            ${isPaid ? 'ชำระแล้ว' : 'ค้างชำระ'}
                        </span>
                    </td>
                    <td class="p-3.5 text-center admin-only ${currentUser.role === 'admin' ? '' : 'hide'}">
                        <button onclick="toggleFeeStatus('${weekKey}', '${name}')" class="px-3 py-1 rounded-lg text-xs font-semibold ${isPaid ? 'bg-slate-200 text-slate-700 hover:bg-slate-300' : 'bg-indigo-600 text-white hover:bg-indigo-700'} transition">
                            ${isPaid ? 'ยกเลิกสถานะ' : 'รับเงิน'}
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('paidCount').textContent = paidCount;
            document.getElementById('unpaidCount').textContent = 38 - paidCount;
            document.getElementById('weekTotalAmount').textContent = paidCount * 10;

            updateFundSummary();
        }

        function toggleFeeStatus(weekKey, studentName) {
            const current = !!db.fees[weekKey][studentName];
            db.fees[weekKey][studentName] = !current;
            saveData();
            renderFeeTable();
        }

        function updateFundSummary() {
            let totalCollected = 0;
            // Calculate total collected across all weeks 1-16
            for (let i = 1; i <= 16; i++) {
                const wk = `week_${i}`;
                if (db.fees[wk]) {
                    Object.values(db.fees[wk]).forEach(val => {
                        if (val) totalCollected += 10;
                    });
                }
            }

            let totalWithdrawn = 0;
            db.withdrawals.forEach(w => {
                totalWithdrawn += Number(w.amount) || 0;
            });

            const net = totalCollected - totalWithdrawn;
            document.getElementById('netFundBalance').textContent = net.toLocaleString() + ' บาท';
            document.getElementById('totalCollected').textContent = totalCollected.toLocaleString() + ' บาท';
            document.getElementById('totalWithdrawn').textContent = totalWithdrawn.toLocaleString() + ' บาท';
        }

        // Withdrawals
        function openWithdrawModal() {
            document.getElementById('withdrawModal').classList.remove('hide');
            document.getElementById('withdrawTitle').value = '';
            document.getElementById('withdrawAmount').value = '';
        }
        function closeWithdrawModal() {
            document.getElementById('withdrawModal').classList.add('hide');
        }
        function saveWithdraw() {
            const title = document.getElementById('withdrawTitle').value.trim();
            const amount = Number(document.getElementById('withdrawAmount').value);
            if (!title || !amount) {
                alert('กรุณากรอกข้อมูลการเบิกให้ครบถ้วน');
                return;
            }
            db.withdrawals.unshift({
                id: Date.now(),
                title,
                amount,
                date: new Date().toLocaleString('th-TH'),
                by: currentUser.nickname || currentUser.name
            });
            saveData();
            closeWithdrawModal();
            renderWithdrawals();
            updateFundSummary();
        }
        function renderWithdrawals() {
            const tbody = document.getElementById('withdrawTableBody');
            tbody.innerHTML = '';
            if (db.withdrawals.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-slate-400">ยังไม่มีรายการเบิกเงินห้อง</td></tr>`;
                return;
            }
            db.withdrawals.forEach(w => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50 transition';
                tr.innerHTML = `
                    <td class="p-3 text-slate-500 text-xs">${w.date}</td>
                    <td class="p-3 font-medium text-slate-800">${w.title}</td>
                    <td class="p-3 text-right font-bold text-rose-600">-${w.amount.toLocaleString()}</td>
                    <td class="p-3 text-slate-600 text-xs">${w.by}</td>
                    <td class="p-3 text-center admin-only ${currentUser.role === 'admin' ? '' : 'hide'}">
                        <button onclick="deleteWithdraw(${w.id})" class="text-slate-400 hover:text-rose-600 transition"><i class="fa-solid fa-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }
        function deleteWithdraw(id) {
            if (confirm('ต้องการลบรายการเบิกนี้ใช่หรือไม่?')) {
                db.withdrawals = db.withdrawals.filter(w => w.id !== id);
                saveData();
                renderWithdrawals();
                updateFundSummary();
            }
        }

        // --- TAB 2: HOMEWORK ---
        function openHomeworkModal() {
            document.getElementById('homeworkModal').classList.remove('hide');
            document.getElementById('hwSubject').value = '';
            document.getElementById('hwDesc').value = '';
            document.getElementById('hwDueDate').value = '';
        }
        function closeHomeworkModal() {
            document.getElementById('homeworkModal').classList.add('hide');
        }
        function saveHomework() {
            const subject = document.getElementById('hwSubject').value.trim();
            const desc = document.getElementById('hwDesc').value.trim();
            const dueDate = document.getElementById('hwDueDate').value;
            if (!subject || !desc) {
                alert('กรุณากรอกวิชาและรายละเอียดงาน');
                return;
            }
            db.homework.unshift({
                id: Date.now(),
                subject,
                desc,
                dueDate: dueDate || 'ไม่ระบุ',
                by: currentUser.nickname || currentUser.name
            });
            saveData();
            closeHomeworkModal();
            renderHomework();
        }
        function renderHomework() {
            const grid = document.getElementById('homeworkGrid');
            grid.innerHTML = '';
            if (db.homework.length === 0) {
                grid.innerHTML = `<div class="col-span-full bg-white p-8 rounded-2xl border border-slate-200 text-center text-slate-400">ยังไม่มีรายการการบ้านในขณะนี้</div>`;
                return;
            }
            db.homework.forEach(hw => {
                const card = document.createElement('div');
                card.className = 'bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between space-y-4';
                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="px-3 py-1 bg-indigo-50 text-indigo-600 text-xs font-bold rounded-lg">${hw.subject}</span>
                            <span class="text-xs text-slate-400"><i class="fa-regular fa-clock mr-1"></i> กำหนดส่ง: ${hw.dueDate}</span>
                        </div>
                        <p class="text-slate-700 text-sm whitespace-pre-line">${hw.desc}</p>
                    </div>
                    <div class="flex items-center justify-between pt-3 border-t border-slate-100 text-xs text-slate-400">
                        <span>โพสต์โดย: ${hw.by}</span>
                        <button onclick="deleteHomework(${hw.id})" class="admin-only ${currentUser.role === 'admin' ? '' : 'hide'} text-rose-500 hover:text-rose-700 font-semibold">ลบงาน</button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }
        function deleteHomework(id) {
            if (confirm('ต้องการลบการบ้านนี้ใช่หรือไม่?')) {
                db.homework = db.homework.filter(h => h.id !== id);
                saveData();
                renderHomework();
            }
        }

        // --- TAB 3: LOST & FOUND ---
        let tempLostImage = '';
        function openLostModal() {
            document.getElementById('lostModal').classList.remove('hide');
            document.getElementById('lostItemName').value = '';
            document.getElementById('lostDesc').value = '';
            tempLostImage = '';
            document.getElementById('lostImagePreview').classList.add('hide');
        }
        function closeLostModal() {
            document.getElementById('lostModal').classList.add('hide');
        }
        function previewLostImage(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    tempLostImage = e.target.result;
                    const prev = document.getElementById('lostImagePreview');
                    prev.src = tempLostImage;
                    prev.classList.remove('hide');
                }
                reader.readAsDataURL(file);
            }
        }
        function saveLostItem() {
            const type = document.getElementById('lostType').value;
            const name = document.getElementById('lostItemName').value.trim();
            const desc = document.getElementById('lostDesc').value.trim();
            if (!name) {
                alert('กรุณาระบุชื่อสิ่งของ');
                return;
            }
            db.lostItems.unshift({
                id: Date.now(),
                type,
                name,
                desc,
                image: tempLostImage,
                date: new Date().toLocaleString('th-TH'),
                by: currentUser.nickname || currentUser.name
            });
            saveData();
            closeLostModal();
            renderLostItems();
        }
        function renderLostItems() {
            const grid = document.getElementById('lostGrid');
            grid.innerHTML = '';
            if (db.lostItems.length === 0) {
                grid.innerHTML = `<div class="col-span-full bg-white p-8 rounded-2xl border border-slate-200 text-center text-slate-400">ไม่มีประกาศของหายหรือพบของในขณะนี้</div>`;
                return;
            }
            db.lostItems.forEach(item => {
                const isLost = item.type === 'lost';
                const card = document.createElement('div');
                card.className = 'bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between space-y-4';
                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="px-3 py-1 ${isLost ? 'bg-rose-50 text-rose-600' : 'bg-emerald-50 text-emerald-600'} text-xs font-bold rounded-lg">
                                ${isLost ? '<i class="fa-solid fa-magnifying-glass mr-1"></i> ตามหาของหาย' : '<i class="fa-solid fa-gift mr-1"></i> พบของ'}
                            </span>
                            <span class="text-xs text-slate-400">${item.date}</span>
                        </div>
                        <h4 class="font-bold text-slate-900 text-base mb-1">${item.name}</h4>
                        <p class="text-slate-600 text-sm mb-3">${item.desc || 'ไม่มีรายละเอียดเพิ่มเติม'}</p>
                        ${item.image ? `<img src="${item.image}" class="w-full h-36 object-cover rounded-xl border border-slate-100 mb-2">` : ''}
                    </div>
                    <div class="flex items-center justify-between pt-3 border-t border-slate-100 text-xs text-slate-400">
                        <span>ผู้แจ้ง: ${item.by}</span>
                        <button onclick="deleteLostItem(${item.id})" class="${currentUser.role === 'admin' || currentUser.nickname === item.by ? '' : 'hide'} text-rose-500 hover:text-rose-700 font-semibold">ลบโพสต์</button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }
        function deleteLostItem(id) {
            if (confirm('ต้องการลบโพสต์นี้ใช่หรือไม่?')) {
                db.lostItems = db.lostItems.filter(i => i.id !== id);
                saveData();
                renderLostItems();
            }
        }

        // --- TAB 4: ANNOUNCEMENTS ---
        function openAnnouncementModal() {
            document.getElementById('announcementModal').classList.remove('hide');
            document.getElementById('annTitle').value = '';
            document.getElementById('annContent').value = '';
        }
        function closeAnnouncementModal() {
            document.getElementById('announcementModal').classList.add('hide');
        }
        function saveAnnouncement() {
            const title = document.getElementById('annTitle').value.trim();
            const content = document.getElementById('annContent').value.trim();
            if (!title || !content) {
                alert('กรุณากรอกหัวข้อและเนื้อหาประกาศ');
                return;
            }
            db.announcements.unshift({
                id: Date.now(),
                title,
                content,
                date: new Date().toLocaleString('th-TH'),
                by: currentUser.nickname || currentUser.name
            });
            saveData();
            closeAnnouncementModal();
            renderAnnouncements();
        }
        function renderAnnouncements() {
            const list = document.getElementById('announcementList');
            list.innerHTML = '';
            if (db.announcements.length === 0) {
                list.innerHTML = `<div class="bg-white p-8 rounded-2xl border border-slate-200 text-center text-slate-400">ยังไม่มีประกาศจากห้องเรียนในขณะนี้</div>`;
                return;
            }
            db.announcements.forEach(ann => {
                const card = document.createElement('div');
                card.className = 'bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-2';
                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <h4 class="font-bold text-slate-900 text-lg flex items-center">
                            <i class="fa-solid fa-bullhorn text-indigo-600 mr-2"></i> ${ann.title}
                        </h4>
                        <span class="text-xs text-slate-400">${ann.date}</span>
                    </div>
                    <p class="text-slate-700 text-sm whitespace-pre-line pl-6">${ann.content}</p>
                    <div class="flex items-center justify-between pt-2 pl-6 text-xs text-slate-400 border-t border-slate-50 mt-3">
                        <span>ประกาศโดย: ${ann.by}</span>
                        <button onclick="deleteAnnouncement(${ann.id})" class="admin-only ${currentUser.role === 'admin' ? '' : 'hide'} text-rose-500 hover:text-rose-700 font-semibold">ลบประกาศ</button>
                    </div>
                `;
                list.appendChild(card);
            });
        }
        function deleteAnnouncement(id) {
            if (confirm('ต้องการลบประกาศนี้ใช่หรือไม่?')) {
                db.announcements = db.announcements.filter(a => a.id !== id);
                saveData();
                renderAnnouncements();
            }
        }
    </script>
</body>
</html>
