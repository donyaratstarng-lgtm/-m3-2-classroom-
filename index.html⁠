<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Classroom Hub - ม.3/2</title>
    <!-- Tailwind CSS & FontAwesome -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Prompt', sans-serif; }
        .hide { display: none !important; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- LOGIN SCREEN -->
    <div id="loginScreen" class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md p-8 border border-slate-100">
            <div class="text-center mb-6">
                <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center mx-auto mb-3 text-2xl font-bold shadow-inner">
                    <i class="fa-solid fa-school"></i>
                </div>
                <h1 class="text-2xl font-bold text-slate-900">ห้องเรียน ม.3/2</h1>
                <p class="text-slate-500 text-sm">กรุณาเลือกรายชื่อเพื่อเข้าสู่ระบบ</p>
            </div>
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">เลือกรายชื่อของคุณ</label>
                    <select id="loginStudentSelect" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-slate-50 text-slate-700">
                        <option value="">-- เลือกรายชื่อนักเรียน (38 คน) --</option>
                    </select>
                </div>
                <button onclick="handleLogin()" class="w-full py-3.5 bg-indigo-600 text-white font-semibold rounded-xl shadow-lg shadow-indigo-200 hover:bg-indigo-700 transition">
                    เข้าสู่ระบบ
                </button>
                <div class="text-center pt-2 border-t border-slate-100">
                    <button onclick="openAdminLoginModal()" class="text-xs text-slate-400 hover:text-indigo-600 font-medium transition">
                        <i class="fa-solid fa-lock mr-1"></i> เข้าสู่ระบบแอดมิน
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN APP CONTAINER -->
    <div id="mainApp" class="flex-1 flex flex-col hide">
        <!-- HEADER -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-indigo-600 text-white rounded-xl flex items-center justify-center font-bold text-lg shadow-md shadow-indigo-100">
                        M
                    </div>
                    <div>
                        <h2 class="font-bold text-slate-900 leading-tight">มัธยมศึกษาปีที่ 3/2</h2>
                        <span id="headerRoleBadge" class="text-xs px-2 py-0.5 bg-slate-100 text-slate-600 rounded-full font-medium">นักเรียน</span>
                    </div>
                </div>
                
                <div class="flex items-center space-x-3">
                    <!-- Profile Widget -->
                    <div onclick="openProfileModal()" class="flex items-center space-x-2 bg-slate-100 hover:bg-slate-200 transition px-3 py-1.5 rounded-full cursor-pointer">
                        <img id="navUserAvatar" src="" class="w-7 h-7 rounded-full object-cover border border-white bg-slate-300" alt="Avatar">
                        <span id="navUserName" class="text-sm font-medium text-slate-700 max-w-[120px] truncate">ชื่อเล่น</span>
                    </div>
                    <!-- Admin Toggle Button -->
                    <button id="adminToggleBtn" onclick="toggleAdminMode()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-sm font-medium transition flex items-center space-x-1">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span class="hidden sm:inline" id="adminBtnText">โหมดแอดมิน</span>
                    </button>
                    <button onclick="logout()" class="p-2 text-slate-400 hover:text-rose-600 transition" title="ออกจากระบบ">
                        <i class="fa-solid fa-right-from-bracket text-lg"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- NAVIGATION TABS -->
        <nav class="bg-white border-b border-slate-100 shadow-xs">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex space-x-1 overflow-x-auto py-2">
                <button onclick="switchTab('fund')" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold text-indigo-600 bg-indigo-50 transition flex items-center space-x-2 shrink-0" data-tab="fund">
                    <i class="fa-solid fa-wallet"></i><span>คลังเงินห้อง</span>
                </button>
                <button onclick="switchTab('homework')" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 transition flex items-center space-x-2 shrink-0" data-tab="homework">
                    <i class="fa-solid fa-book-open"></i><span>การบ้าน & ส่งงาน</span>
                </button>
                <button onclick="switchTab('lostfound')" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 transition flex items-center space-x-2 shrink-0" data-tab="lostfound">
                    <i class="fa-solid fa-box-archive"></i><span>ตามของหาย</span>
                </button>
                <button onclick="switchTab('announcement')" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 transition flex items-center space-x-2 shrink-0" data-tab="announcement">
                    <i class="fa-solid fa-bullhorn"></i><span>กระดานประกาศ</span>
                </button>
            </div>
        </nav>

        <!-- CONTENT AREA -->
        <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
            
            <!-- TAB 1: FUND & CLASS FEE -->
            <div id="tab-fund" class="space-y-6">
                <!-- Summary Cards -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center space-x-4">
                        <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center text-xl font-bold">
                            <i class="fa-solid fa-sack-dollar"></i>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase">เงินห้องคงเหลือสุทธิ</p>
                            <h3 id="netFundBalance" class="text-2xl font-bold text-slate-800">0 บาท</h3>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center space-x-4">
                        <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center text-xl font-bold">
                            <i class="fa-solid fa-arrow-trend-up"></i>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase">ยอดเก็บสะสมรวม</p>
                            <h3 id="totalCollected" class="text-2xl font-bold text-slate-800">0 บาท</h3>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center space-x-4">
                        <div class="w-12 h-12 bg-rose-100 text-rose-600 rounded-xl flex items-center justify-center text-xl font-bold">
                            <i class="fa-solid fa-arrow-trend-down"></i>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase">เบิกเงินรวม</p>
                            <h3 id="totalWithdrawn" class="text-2xl font-bold text-slate-800">0 บาท</h3>
                        </div>
                    </div>
                </div>

                <!-- Section: Weekly Fee Tracking (10 Baht/Week) -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-xs p-6">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                        <div>
                            <h3 class="text-lg font-bold text-slate-900">ระบบเช็คชื่อ & ทวงค่าห้องรายสัปดาห์ (สัปดาห์ละ 10 บาท)</h3>
                            <p class="text-xs text-slate-500">เลือกสัปดาห์เพื่อตรวจสอบหรือบันทึกสถานะการชำระเงินของสมาชิกทั้ง 38 คน</p>
                        </div>
                        <!-- Week Selector -->
                        <div class="flex items-center space-x-2">
                            <label class="text-xs font-semibold text-slate-600">สัปดาห์ที่:</label>
                            <select id="feeWeekSelect" onchange="renderFeeTable()" class="px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 text-sm font-semibold text-indigo-600 focus:outline-none">
                                <!-- Generated by JS 1-16 -->
                            </select>
                        </div>
                    </div>

                    <!-- Fee Status Summary for Selected Week -->
                    <div class="bg-indigo-50/50 rounded-xl p-4 mb-4 flex flex-wrap items-center justify-between gap-4 border border-indigo-100">
                        <div class="flex items-center space-x-3">
                            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
                            <span class="text-sm font-medium text-slate-700">ชำระแล้ว: <strong id="paidCount" class="text-emerald-600">0</strong> คน</span>
                            <span class="w-3 h-3 rounded-full bg-rose-500 ml-4"></span>
                            <span class="text-sm font-medium text-slate-700">ค้างชำระ: <strong id="unpaidCount" class="text-rose-600">38</strong> คน</span>
                        </div>
                        <div class="text-sm font-semibold text-indigo-900">
                            ยอดเงินสัปดาห์นี้: <span id="weekTotalAmount" class="text-indigo-600 text-base">0</span> บาท
                        </div>
                    </div>

                    <!-- Students Fee Table -->
                    <div class="overflow-x-auto rounded-xl border border-slate-100">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-xs font-bold text-slate-500 uppercase tracking-wider">
                                    <th class="p-3.5 text-center w-16">เลขที่</th>
                                    <th class="p-3.5">ชื่อ -สกุล</th>
                                    <th class="p-3.5">ชื่อเล่น</th>
                                    <th class="p-3.5 text-center">สถานะค่าห้อง (10 บาท)</th>
                                    <th class="p-3.5 text-center admin-only hide">จัดการ (แอดมิน)</th>
                                </tr>
                            </thead>
                            <tbody id="feeTableBody" class="divide-y divide-slate-100 text-sm">
                                <!-- Populated by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Section: Withdrawal Records -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-xs p-6">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h3 class="text-lg font-bold text-slate-900">รายการเบิกเงินห้อง</h3>
                            <p class="text-xs text-slate-500">บันทึกประวัติการเบิกจ่ายเงินสำหรับกิจกรรมห้องเรียน</p>
                        </div>
                        <button onclick="openWithdrawModal()" class="admin-only hide px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-md transition flex items-center space-x-1.5">
                            <i class="fa-solid fa-plus text-xs"></i><span>เบิกเงิน</span>
                        </button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-xs font-bold text-slate-500 uppercase">
                                    <th class="p-3">วันที่ / เวลา</th>
                                    <th class="p-3">รายการเบิก</th>
                                    <th class="p-3 text-right">จำนวนเงิน (บาท)</th>
                                    <th class="p-3">ผู้เบิก</th>
                                    <th class="p-3 text-center admin-only hide w-16">ลบ</th>
                                </tr>
                            </thead>
                            <tbody id="withdrawTableBody" class="divide-y divide-slate-100 text-sm">
                                <!-- Populated by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB 2: HOMEWORK -->
            <div id="tab-homework" class="space-y-6 hide">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <h3 class="text-xl font-bold text-slate-900">สรุปการบ้าน & กำหนดส่งงาน</h3>
                        <p class="text-xs text-slate-500">เช็ครายการการบ้านวิชาต่างๆ และกำหนดส่งประจำวัน</p>
                    </div>
                    <button onclick="openHomeworkModal()" class="admin-only hide px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-md transition flex items-center space-x-1.5">
                        <i class="fa-solid fa-plus text-xs"></i><span>เพิ่มการบ้านใหม่</span>
                    </button>
                </div>
                <!-- Homework Cards Grid -->
                <div id="homeworkGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <!-- Populated by JS -->
                </div>
            </div>

            <!-- TAB 3: LOST & FOUND -->
            <div id="tab-lostfound" class="space-y-6 hide">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <h3 class="text-xl font-bold text-slate-900">บอร์ดตามของหาย / ของลืมในห้อง</h3>
                        <p class="text-xs text-slate-500">โพสต์ตามหาของหรือแจ้งของที่พบในห้องเรียน</p>
                    </div>
                    <button onclick="openLostModal()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-md transition flex items-center space-x-1.5">
                        <i class="fa-solid fa-plus text-xs"></i><span>แจ้งของหาย / พบของ</span>
                    </button>
                </div>
                <!-- Lost Items Grid -->
                <div id="lostGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <!-- Populated by JS -->
                </div>
            </div>

            <!-- TAB 4: ANNOUNCEMENTS -->
            <div id="tab-announcement" class="space-y-6 hide">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <h3 class="text-xl font-bold text-slate-900">กระดานประกาศห้องเรียน</h3>
                        <p class="text-xs text-slate-500">ประกาศสำคัญจากหัวหน้าห้องหรือครูประจำชั้น</p>
                    </div>
                    <button onclick="openAnnouncementModal()" class="admin-only hide px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-md transition flex items-center space-x-1.5">
                        <i class="fa-solid fa-plus text-xs"></i><span>สร้างประกาศใหม่</span>
                    </button>
                </div>
                <div id="announcementList" class="space-y-4">
                    <!-- Populated by JS -->
                </div>
            </div>

        </main>
    </div>

    <!-- MODALS -->

    <!-- Profile Edit Modal -->
    <div id="profileModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hide">
        <div class="bg-white rounded-3xl shadow-xl w-full max-w-sm p-6 space-y-4">
            <h3 class="text-lg font-bold text-slate-900">แก้ไขข้อมูลส่วนตัว</h3>
            <div class="space-y-3">
                <div class="text-center">
                    <img id="modalProfilePreview" src="" class="w-20 h-20 rounded-full object-cover mx-auto mb-2 border-2 border-indigo-100 shadow-sm bg-slate-200">
                    <label class="inline-block px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl cursor-pointer transition">
                        <i class="fa-solid fa-camera mr-1"></i> เปลี่ยนรูปภาพ
                        <input type="file" id="profileImageInput" accept="image/*" class="hide" onchange="previewProfileImage(event)">
                    </label>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">ชื่อจริง (ล็อกอิน)</label>
                    <input type="text" id="modalRealName" disabled class="w-full px-3 py-2 rounded-xl border border-slate-200 bg-slate-100 text-slate-500 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">ชื่อเล่น</label>
                    <input type="text" id="modalNicknameInput" placeholder="ระบุชื่อเล่นของคุณ" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>
            </div>
            <div class="flex space-x-2 pt-2">
                <button onclick="closeProfileModal()" class="flex-1 py-2.5 bg-slate-100 text-slate-600 rounded-xl font-semibold text-sm hover:bg-slate-200 transition">ยกเลิก</button>
                <button onclick="saveProfile()" class="flex-1 py-2.5 bg-indigo-600 text-white rounded-xl font-semibold text-sm hover:bg-indigo-700 transition">บันทึก</button>
            </div>
        </div>
    </div>

    <!-- Admin Login Modal -->
    <div id="adminLoginModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hide">
        <div class="bg-white rounded-3xl shadow-xl w-full max-w-sm p-6 space-y-4">
            <h3 class="text-lg font-bold text-slate-900">เข้าสู่ระบบแอดมิน</h3>
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">รหัสผ่านแอดมิน (ค่าเริ่มต้น: 1234)</label>
                <input type="password" id="adminPasswordInput" placeholder="กรอกรหัสผ่าน" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            </div>
            <div class="flex space-x-2 pt-2">
                <button onclick="closeAdminLoginModal()" class="flex-1 py-2.5 bg-slate-100 text-slate-600 rounded-xl font-semibold text-sm hover:bg-slate-200 transition">ยกเลิก</button>
                <button onclick="verifyAdminLogin()" class="flex-1 py-2.5 bg-indigo-600 text-white rounded-xl font-semibold text-sm hover:bg-indigo-700 transition">ยืนยัน</button>
            </div>
        </div>
    </div>

    <!-- Withdraw Modal -->
    <div id="withdrawModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hide">
        <div class="bg-white rounded-3xl shadow-xl w-full max-w-sm p-6 space-y-4">
            <h3 class="text-lg font-bold text-slate-900">บันทึกเบิกเงินห้อง</h3>
            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">รายการเบิก</label>
                    <input type="text" id="withdrawTitle" placeholder="เช่น ค่าบอร์ด, ค่าอุปกรณ์ทำความสะอาด" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">จำนวนเงิน (บาท)</label>
                    <input type="number" id="withdrawAmount" placeholder="0" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>
            </div>
            <div class="flex space-x-2 pt-2">
                <button onclick="closeWithdrawModal()" class="flex-1 py-2.5 bg-slate-100 text-slate-600 rounded-xl font-semibold text-sm hover:bg-slate-200 transition">ยกเลิก</button>
                <button onclick="saveWithdraw()" class="flex-1 py-2.5 bg-indigo-600 text-white rounded-xl font-semibold text-sm hover:bg-indigo-700 transition">บันทึกการเบิก</button>
            </div>
        </div>
    </div>

    <!-- Homework Modal -->
    <div id="homeworkModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hide">
        <div class="bg-white rounded-3xl shadow-xl w-full max-w-md p-6 space-y-4">
            <h3 class="text-lg font-bold text-slate-900">เพิ่มรายการการบ้าน</h3>
            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">วิชา</label>
                    <input type="text" id="hwSubject" placeholder="เช่น คณิตศาสตร์, วิทยาศาสตร์" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">รายละเอียดงาน</label>
                    <textarea id="hwDesc" rows="3" placeholder="ระบุรายละเอียดงานและการบ้าน..." class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"></textarea>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">กำหนดส่ง</label>
                    <input type="date" id="hwDueDate" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>
            </div>
            <div class="flex space-x-2 pt-2">
                <button onclick="closeHomeworkModal()" class="flex-1 py-2.5 bg-slate-100 text-slate-600 rounded-xl font-semibold text-sm hover:bg-slate-200 transition">ยกเลิก</button>
                <button onclick="saveHomework()" class="flex-1 py-2.5 bg-indigo-600 text-white rounded-xl font-semibold text-sm hover:bg-indigo-700 transition">บันทึกงาน</button>
            </div>
        </div>
    </div>

    <!-- Lost & Found Modal -->
    <div id="lostModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hide">
        <div class="bg-white rounded-3xl shadow-xl w-full max-w-md p-6 space-y-4">
