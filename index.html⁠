                    <label class="block text-xs font-semibold text-slate-600 mb-1">ชื่อสิ่งของ</label>
                    <input type="text" id="lostItemName" placeholder="เช่น หูฟังบลูทูธ, สมุดคณิตศาสตร์" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">รายละเอียด / จุดที่ลืมหรือพบ</label>
